const calculateBill = (units) => {
    if (units <= 20) {
      return units * 5 + 50;
    }
    if (units <= 50) {
      return 20 * 5 + (units - 20) * 7 + 50;
    }
    return 20 * 5 + 30 * 7 + (units - 50) * 10 + 50;
  };

  const displayBill = (name, units, callback) => {
    const totalBill = callback(units);
    console.log(`Customer: ${name}`);
    console.log(`Units Consumed: ${units}`);
    console.log(`Total Electricity Bill: Rs. ${totalBill}`);
  };

  displayBill("Ram", 42, calculateBill);



  
